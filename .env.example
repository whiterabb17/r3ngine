#
# General
#
COMPOSE_PROJECT_NAME=r3ngine

#
# SSL specific configuration
#
AUTHORITY_NAME=r3Ngine
# CHANGE ME: set a strong random password (e.g. openssl rand -base64 32)
AUTHORITY_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
COMPANY=r3Ngine
DOMAIN_NAME=r3ngine.example.com
COUNTRY_CODE=US
STATE=Georgia
CITY=Atlanta

#
# Database configurations
#
POSTGRES_DB=r3ngine
POSTGRES_USER=r3ngine
# CHANGE ME: set a strong random password (e.g. openssl rand -base64 32)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_PORT=5432
POSTGRES_HOST=db
POSTGRES_SSLMODE=prefer
#
# LLM features (Tier 7 impact assessment, GPT vulnerability reports, ...)
#
# Deprecated: the operator switch lives in Settings → AI Hub. This env var is
# ignored by the application. Kept so existing .env files still parse.
LLM_ENABLED=0

#
# Concurrency
#
MAX_CONCURRENCY=40
MIN_CONCURRENCY=10
PROXY_VALIDATION_TIMEOUT=10
PROXY_VALIDATION_MAX_WORKERS=50

#
# r3ngine web interface super user (for non-interactive install)
#
DJANGO_SUPERUSER_USERNAME=r3ngine
DJANGO_SUPERUSER_EMAIL=r3ngine@example.com
# CHANGE ME: set a strong random password (e.g. openssl rand -base64 32)
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
# CHANGE ME: set a strong random password (e.g. openssl rand -base64 32)

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=CHANGE_ME
NEO4J_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
NEO4J_USER=neo4j
NEO4J_URI=bolt://neo4j:7687

# Redis configurations
# CHANGE ME: set a strong random password (e.g. openssl rand -base64 32)
REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
#
# Optional services (compose profiles) — optional
#
# Comma-separated profiles to include in `make up` and the other service
# targets. The application only checks that these services answer; it does
# not start them, and nothing mounts the Docker socket.
#   tor     - Tor SOCKS proxy behind "TOR Mode" (Settings -> Proxy)
#   ollama  - local Ollama backend for the LLM Toolkit (http://ollama:11434)
# COMPOSE_PROFILES=tor,ollama
# Required with the tor profile: the control-port password shared by the tor
# service and the app (used to rotate circuits between scan phases).
# CHANGE ME: set a strong random password (e.g. openssl rand -base64 32)
# TOR_CONTROL_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
# Ollama image variant in docker/ollama/: Dockerfile (CPU, default),
# nvidia.Dockerfile or amd.Dockerfile.
# OLLAMA_DOCKERFILE=Dockerfile

#
# Application image — optional
#
# `make up` builds the image locally and tags it r3ngine:local. Set this to a
# registry image built from this repository to deploy without building; remote
# workers (docker/docker-compose.worker.yml) require it.
# R3NGINE_IMAGE=ghcr.io/<owner>/r3ngine:latest

#
# Remote workers (docker/docker-compose.worker.yml) — optional
#
# The worker token is created in Settings -> Remote Workers and shown once.
# WORKER_NAME=worker-eu-1
# WORKER_AUTH_TOKEN=r3n_wkr_...
# MASTER_URL=https://r3ngine.example.com
# The heartbeat verifies the master's certificate; for a self-signed master,
# give the path of its CA file inside the worker container.
# MASTER_CA_BUNDLE=/certs/rootCA.pem
# MASTER_TLS_VERIFY=1

#
# Security — optional overrides
#
# Restrict CORS to your actual frontend origin(s) in production
# CORS_ALLOWED_ORIGINS=https://your-rengine-domain.example.com
# Set allowed hosts (comma-separated) in production
# ALLOWED_HOSTS=your-rengine-domain.example.com
# Obscure the Django admin URL from /admin/ to something less guessable
# DJANGO_ADMIN_URL=your_secret_admin_path
# Acunetix CA bundle path (if Acunetix uses a self-signed cert you trust)
# ACUNETIX_CA_BUNDLE=/path/to/ca-bundle.pem
